# ------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env
# ------------------------------------------------------------------

# --- Gateway ---
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
MAX_UPLOAD_MB=10

# --- Internal services (HTTP/JSON only; services never import each other) ---
NORMALIZE_URL=http://127.0.0.1:8081
RETRIEVAL_URL=http://127.0.0.1:8082
SERVICE_TIMEOUT_S=60

# --- Database (PostgreSQL + pgvector) ---
# Prod target. In M1 the index is built with FAISS/numpy because the Docker daemon
# is not required for local development.
POSTGRES_USER=svoe
POSTGRES_PASSWORD=svoe
POSTGRES_DB=svoe_vino
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://svoe:svoe@127.0.0.1:5432/svoe_vino

# --- Retrieval / encoder ---
# ENCODER=siglip2 uses google/siglip2-base-patch16-224 (Apache-2.0).
# Set ENCODER_MODEL to pin an exact revision or to use the larger TZ model
# google/siglip2-so400m-patch16-naflex.
ENCODER=siglip2                  # siglip2 | dinov2 | clip
ENCODER_MODEL=                   # empty = default for ENCODER
ENCODER_DEVICE=auto              # auto | mps | cuda | cpu
VECTOR_BACKEND=numpy            # numpy (default) | faiss — на macOS arm64 faiss (libomp)
                                # конфликтует с torch: OMP Error #15, поэтому numpy
TOP_K=30
INDEX_DIR=data/index

# --- Decision thresholds (calibrated in C-003 on synthetic proxy, seed 42) ---
SCORE_TAU=0.7171                 # порог итогового скора (разделение верных/неверных, F1 0.91)
MARGIN_DELTA=0.0659              # минимальный отрыв top1-top2 (F1 0.90)
CONFIDENCE_TEMPERATURE=0.2       # температура softmax для confidence (F1 0.91)

# --- Geo-verification (C-003): SIFT/ORB + BFMatcher + RANSAC поверх Top-K ---
GEO_WEIGHT=2.5                   # вес геоверификации в фьюжн-скоке (калибровка: 0.495 -> 0.680 acc@1)
GEO_TOPK=10                      # сколько верхних кандидатов верифицировать
GEO_MIN_MATCHES=8                # минимум хороших матчей для RANSAC
GEO_METHOD=orb                   # orb (компактно) | sift (точнее, тяжелее)
WARMUP_ON_START=1                # прогрев модели, головы и индекса при старте (SLA на первом запросе)

# --- LLM Router (C-008): единый chat()/embed() с цепочкой провайдеров ---
# Провайдеры, роли и лимиты живут в config/providers.yaml; здесь только секреты и режимы.
LLM_PROVIDERS_FILE=config/providers.yaml
LLM_LOCAL_ONLY=0                 # 1 = только локальные провайдеры (Ollama/LM Studio), облако не вызывается

# Локальные провайдеры (ключи не нужны, но подставляются как есть)
LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_OLLAMA_API_KEY=ollama
LLM_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LLM_LMSTUDIO_API_KEY=lmstudio

# Облачные провайдеры (fallback): задайте ключ, иначе провайдер выпадет из цепочки
OPENROUTER_API_KEY=
OPENROUTER_REFERER=http://localhost
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- Full-frame preprocessing (C-012) ---
# Полный кадр — база и для retrieval, и для VLM: этикетку НЕ обрезаем (овальная форма,
# цилиндр, блики, углы). Кроп-варп включается только флагом.
NORMALIZE_CROP=0                 # 1 = включить детекцию и выпрямление этикетки (не рекомендуется)
NORMALIZE_ENHANCE=0              # CLAHE + баланс белого; включается в P&S-наборе
PAS_TILES=4                      # pan-and-scan тайлов по всему кадру (базовый режим)
PAS_TILES_UNCERTAIN=6            # тайлов для неуверенного случая
VLM_NUM_CTX=8192                 # контекст VLM: дефолт 2048 вызывал галлюцинации/усечение

# --- VLM fallback (C-004): ТОЛЬКО для неуверенных ответов Tier-1 ---
# По умолчанию ВЫКЛЮЧЕН: замер C-004 (20 near-duplicate сэмплов) показал, что локальный VLM
# не даёт прироста точности, но поднимает p95 до ~5 с при цели 3 с.
# Онлайн-модель должна быть быстрой; gemma4:12b (13-18 с) годится только для офлайн-обогащения.
VLM_URL=http://127.0.0.1:8083
VLM_FALLBACK_ENABLED=0           # 1 = включить VLM-fallback в онлайн-пути (осознанно)
VLM_ONLINE_MODEL=gemma4:e4b      # быстрая модель; gemma4:12b НЕ для онлайна
VLM_MAX_TOKENS=192               # минимальный JSON; больше токенов = больше латентность
VLM_TIMEOUT_S=4                  # жёсткий таймаут: при превышении — деградация к Tier-1
VLM_REASONING_EFFORT=none        # критично: отключает внутренние рассуждения (17.4 с -> 3.6 с)

# --- OCR text signal (C-010): дешёвая замена VLM-fallback в онлайн-пути ---
# RapidOCR (Apache-2.0, ONNX) читает год за ~250-290 мс; кириллические слова — best-effort.
OCR_URL=http://127.0.0.1:8085
OCR_ENABLED=1                    # 1 = OCR-сигнал в онлайн-пути при неуверенном Tier-1
OCR_MAX_SIDE=768                 # ограничение стороны для бюджета времени
OCR_TIMEOUT_S=1.5                # при превышении — деградация к Tier-1

# --- Matcher fusion (C-004) ---
MATCHER_URL=http://127.0.0.1:8084
MATCHER_TEXT_WEIGHT=0.6          # вклад текстового матча полей VLM
MATCHER_VINTAGE_BONUS=0.3        # бонус за совпадение года (дизамбигуация near-duplicates)
MATCHER_SWEETNESS_BONUS=0.25     # бонус за совпадение сладости

# --- VLM (OpenAI-compatible connector; wired in C-004/C-008) ---
VLM_PROVIDER=ollama              # ollama | lmstudio | openrouter | yandex | custom
VLM_BASE_URL=http://127.0.0.1:11434/v1
VLM_API_KEY=
VLM_MODEL=gemma4:12b             # main
VLM_MODEL_FAST=gemma4:e4b        # fast / demo
VLM_TIMEOUT_S=8
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=512

# --- Text LLM / sommelier (C-005) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:9b

# --- Embeddings (text/metadata) ---
TEXT_EMBED_MODEL=qwen3-embedding:0.6b

# --- Paths ---
CATALOG_JSONL=data/catalog/catalog.jsonl
SLUG_TO_IMAGE_JSON=data/catalog/slug_to_image.json

# --- C-013: label-text KB и текстовый фьюжн (по умолчанию выключен до валидации на полевых фото) ---
TEXT_FUSION_ENABLED=0
TEXT_FUSION_WEIGHT=0.6
TEXT_FUSION_YEAR_BONUS=0.35
TEXT_FUSION_SWEETNESS_BONUS=0.25
CATALOG_ENRICHED_JSONL=data/catalog/catalog_enriched.jsonl

# --- C-014: условный триггер фьюжна и кириллический OCR ---
TEXT_FUSION_MODE=conditional    # off | conditional | always (conditional: 0 ухудшений в C-014)
TEXT_FUSION_TRIGGER_MAX_GAP=0.05
# PP-OCRv5 mobile cyrillic rec (Apache-2.0). Скачать:
#   curl -L -o data/models/ocr/cyrillic_PP-OCRv5_rec.onnx \
#     https://huggingface.co/PaddlePaddle/cyrillic_PP-OCRv5_mobile_rec_onnx/resolve/main/inference.onnx
#   curl -L -o data/models/ocr/cyrillic_PP-OCRv5_rec.yml \
#     https://huggingface.co/PaddlePaddle/cyrillic_PP-OCRv5_mobile_rec_onnx/resolve/main/inference.yml
# Словарь (cyrillic_dict.txt) извлекается из inference.yml -> PostProcess.character_dict.
OCR_REC_MODEL=
OCR_REC_KEYS=
VLM_26B_MODEL=gemma4:26b-mlx

# --- C-020: движок OCR со стороны запроса ---
# rapidocr (дефолт, латиница+цифры) | fusion (rapidocr + PP-OCRv5 cyrillic, лучше читает,
# но ~2x latency) | cyrillic | paddleocr_vl (лучшее качество, ~3 мин на кадр: только офлайн)
OCR_ENGINE=
OCR_DET_SIDE=1280
OCR_REC_WIDTH=640
OCR_VL_MODEL=data/models/paddleocr_vl
OCR_VL_MAX_TOKENS=1024

# --- C-021: пороги, перекалиброванные под текущий full-frame пайплайн ---
SCORE_TAU=0.7615           # C-022: +0.97 п.п. F1 на мультивью-галерее (было 0.796)
MARGIN_DELTA=0.0058        # C-022: +13.45 п.п. F1 на мультивью-галерее (было 0.0769)
GEO_WEIGHT=0.7             # C-023: на галерее 6 видов 0.7 лучше 0.5 (acc@1 0.770 -> 0.785)
VIEWS=6                    # видов на позицию при сборке индекса (make index); 4 быстрее собирать
CONFIDENCE_TEMPERATURE=0.2 # не менялась: выигрыш альтернативы в пределах шума
