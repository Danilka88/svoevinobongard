# ------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env
# ------------------------------------------------------------------

# --- Gateway ---
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
MAX_UPLOAD_MB=10

# --- Internal services (HTTP/JSON only; services never import each other) ---
NORMALIZE_URL=http://127.0.0.1:8081
RETRIEVAL_URL=http://127.0.0.1:8082
SERVICE_TIMEOUT_S=60

# --- Database (PostgreSQL + pgvector) ---
# Prod target. In M1 the index is built with FAISS/numpy because the Docker daemon
# is not required for local development.
POSTGRES_USER=svoe
POSTGRES_PASSWORD=svoe
POSTGRES_DB=svoe_vino
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://svoe:svoe@127.0.0.1:5432/svoe_vino

# --- Retrieval / encoder ---
# ENCODER=siglip2 uses google/siglip2-base-patch16-224 (Apache-2.0).
# Set ENCODER_MODEL to pin an exact revision or to use the larger TZ model
# google/siglip2-so400m-patch16-naflex.
ENCODER=siglip2                  # siglip2 | dinov2 | clip
ENCODER_MODEL=                   # empty = default for ENCODER
ENCODER_DEVICE=auto              # auto | mps | cuda | cpu
VECTOR_BACKEND=numpy            # numpy (default) | faiss — на macOS arm64 faiss (libomp)
                                # конфликтует с torch: OMP Error #15, поэтому numpy
TOP_K=30
INDEX_DIR=data/index

# --- Decision thresholds (used by C-003) ---
SCORE_TAU=0.55                   # минимальный скор для «уверенно»
MARGIN_DELTA=0.12                # минимальный отрыв top1-top2

# --- VLM (OpenAI-compatible connector; wired in C-004/C-008) ---
VLM_PROVIDER=ollama              # ollama | lmstudio | openrouter | yandex | custom
VLM_BASE_URL=http://127.0.0.1:11434/v1
VLM_API_KEY=
VLM_MODEL=gemma4:12b             # main
VLM_MODEL_FAST=gemma4:e4b        # fast / demo
VLM_TIMEOUT_S=8
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=512

# --- Text LLM / sommelier (C-005) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5:9b

# --- Embeddings (text/metadata) ---
TEXT_EMBED_MODEL=qwen3-embedding:0.6b

# --- Paths ---
CATALOG_JSONL=data/catalog/catalog.jsonl
SLUG_TO_IMAGE_JSON=data/catalog/slug_to_image.json
