<GraceChangePlan graceVersion="4.0" status="draft">
  <C-006>
    <IntentSummary>Замкнуть цикл самоулучшения: логи → фильтр и ревью → аугментация → дообучение →
      оценка и реестр → перезагрузка индекса. Онлайн-путь остаётся прежним.</IntentSummary>

    <BaselineAssertions>
      <MustExist><Value>services/gateway/app/main.py</Value></MustExist>
      <MustExist><Value>data/catalog/catalog.jsonl</Value></MustExist>
      <MustNotExist><Value>services/active-learning/app/main.py</Value></MustNotExist>
      <MustVerify><Module>M-RETRIEVAL</Module></MustVerify>
    </BaselineAssertions>

    <TargetAssertions>
      <MustExist><Value>services/active-learning/</Value></MustExist>
      <MustPassCommand><Command>.venv/bin/python -m pytest tests/ -q</Command></MustPassCommand>
      <MustVerify><Module>M-ACTIVE-LEARNING</Module></MustVerify>
      <MustLink><From>M-ACTIVE-LEARNING</From><To>M-CATALOG</To></MustLink>
    </TargetAssertions>

    <DurableScope>
      <M-ACTIVE-LEARNING/>
      <M-RETRIEVAL/>
      <M-CATALOG/>
      <M-GATEWAY/>
      <V-M-ACTIVE-LEARNING/>
      <DF-005/>
    </DurableScope>

    <ObservedWriteScope>
      <Path>services/active-learning/</Path>
      <Path>services/retrieval/</Path>
      <Path>services/catalog/</Path>
      <Path>services/gateway/app/</Path>
      <Path>tests/</Path>
      <Path>.grace/verification/</Path>
    </ObservedWriteScope>

    <ImplementationPlan>
      <T-001>
        <Title>Логирование запросов: image_hash, кропы, эмбеддинг, top-K, скоры, path, итог, latency</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Запись создаётся на каждый запрос.</Criterion>
          <Criterion>Логи не содержат сырых изображений и секретов.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>.venv/bin/python -m pytest tests/active-learning -v -k logging</Command>
        </Verification>
      </T-001>

      <T-002>
        <Title>Очередь ревью: фильтр по margin и ошибкам, подтверждение метки человеком</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>Кейсы с низким margin или not_found попадают в очередь.</Criterion>
          <Criterion>Неподтверждённая метка не участвует в обучении.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>.venv/bin/python -m pytest tests/active-learning -v -k review</Command>
        </Verification>
      </T-002>

      <T-003>
        <Title>Синтетическая аугментация и дообучение Tier-1 (contrastive или LoRA)</Title>
        <DependsOn>T-002</DependsOn>
        <AcceptanceCriteria>
          <Criterion>Аугментации покрывают фон, ракурс, блики, освещение и перспективу.</Criterion>
          <Criterion>Конфиг обучения воспроизводим и зафиксирован.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>.venv/bin/python -m pytest tests/active-learning -v -k augment</Command>
        </Verification>
      </T-003>

      <T-004>
        <Title>Оценка, реестр версий и перезагрузка индекса без правки кода</Title>
        <DependsOn>T-003</DependsOn>
        <AcceptanceCriteria>
          <Criterion>F1 после дообучения не ниже F1 до на отложенной выборке.</Criterion>
          <Criterion>Версия зарегистрирована с метриками; переключение версии не требует правки кода.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>python3 scripts/eval/evaluate.py --images data/samples/field --endpoint http://127.0.0.1:8080/v1/scan --output predictions.c006.jsonl</Command>
          <Command>.venv/bin/python -m pytest tests/ -q</Command>
        </Verification>
      </T-004>
    </ImplementationPlan>
  </C-006>
</GraceChangePlan>
