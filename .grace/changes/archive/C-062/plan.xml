<GraceChangePlan graceVersion="4.0" status="applied">
  <C-062>
    <IntentSummary>Добавить наблюдение этикетки моделью, поиск по всему каталогу с гибридом и
      включение режима флагом, не меняя поведение по умолчанию.</IntentSummary>
    <BaselineAssertions>
      <MustExist><Value>packages/common/text_rank.py</Value></MustExist>
      <MustExist><Value>services/gateway/app/pipeline.py</Value></MustExist>
      <MustExist><Value>services/vlm/app/extract.py</Value></MustExist>
      <MustVerify><Module>M-EVAL</Module></MustVerify>
    </BaselineAssertions>
    <TargetAssertions>
      <MustExist><Value>packages/common/observer.py</Value></MustExist>
      <MustExist><Value>tests/test_c062_observer.py</Value></MustExist>
      <MustPassCommand><Command>.venv/bin/python -m pytest tests/ -q</Command></MustPassCommand>
      <MustPassCommand><Command>cd apps/web &amp;&amp; bun run build</Command></MustPassCommand>
      <MustVerify><Module>M-EVAL</Module></MustVerify>
      <MustOwn><Owner>GD-001</Owner><Anchor>M-EVAL</Anchor></MustOwn>
