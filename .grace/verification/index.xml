<GraceVerificationIndex graceVersion="4.0">
  <Policy>
    <LogFormat>plain-text; маркеры [M-&lt;ID&gt;][fn][BLOCK] через packages.common.logging.log_marker</LogFormat>
    <Redaction>Логи не содержат сырых изображений и API-ключей; только slug, скоры, latency</Redaction>
    <DeterministicFirst>true</DeterministicFirst>
    <Setup>Локальное окружение: python3 -m venv --system-site-packages .venv
      &amp;&amp; .venv/bin/pip install torch torchvision transformers opencv-python-headless uvicorn python-multipart
      (индекс: PYTHONPATH=. .venv/bin/python scripts/catalog/build_index.py --encoder dinov2)</Setup>
  </Policy>

  <VerificationDocuments>
    <VD-M0-CODE>
      <Path>verification/VD-M0-CODE.xml</Path>
      <Owns>
        <V-M-CATALOG/>
        <V-M-EVAL/>
        <V-M-GATEWAY/>
      </Owns>
    </VD-M0-CODE>
    <VD-M1-TIER1>
      <Path>verification/VD-M1-TIER1.xml</Path>
      <Owns>
        <V-M-CONTRACTS/>
        <V-M-NORMALIZE/>
        <V-M-RETRIEVAL/>
      </Owns>
    </VD-M1-TIER1>
    <VD-M3-VLM>
      <Path>verification/VD-M3-VLM.xml</Path>
      <Owns>
        <V-M-VLM/>
        <V-M-MATCHER/>
      </Owns>
    </VD-M3-VLM>
    <VD-M4-OCR>
      <Path>verification/VD-M4-OCR.xml</Path>
      <Owns>
        <V-M-OCR/>
      </Owns>
    </VD-M4-OCR>
    <VD-M5-WEB>
      <Path>verification/VD-M5-WEB.xml</Path>
      <Owns>
        <V-M-WEB/>
      </Owns>
    </VD-M5-WEB>
    <VD-M6-DEPLOY>
      <Path>verification/VD-M6-DEPLOY.xml</Path>
      <Owns>
        <V-M-DEPLOY/>
      </Owns>
    </VD-M6-DEPLOY>
    <VD-M1-M6-PLANNED>
      <Path>verification/VD-M1-M6-PLANNED.xml</Path>
      <Owns>
        <V-M-ACTIVE-LEARNING/>
      </Owns>
    </VD-M1-M6-PLANNED>
    <VD-SHARED>
      <Path>verification/VD-SHARED.xml</Path>
      <Owns>
        <V-M-COMMON/>
      </Owns>
    </VD-SHARED>
  </VerificationDocuments>

  <Gates>
    <Gate level="module">
      <Check>markup: MODULE_CONTRACT + MODULE_MAP в каждом governed .py</Check>
      <Check>.venv/bin/python -m pytest tests/ -q</Check>
    </Gate>
    <Gate level="phase">
      <Check>python3 scripts/catalog/etl_catalog.py</Check>
      <Check>PYTHONPATH=. .venv/bin/python scripts/catalog/build_index.py --encoder dinov2 --out data/index</Check>
      <Check>PYTHONPATH=. .venv/bin/python scripts/eval/baseline_report.py --index data/index --samples 200 --normalize</Check>
    </Gate>
    <Gate level="final">
      <Check>contract: /v1/eval/predict отдаёт верхнеуровневый slug; ответ быстрее 10 c</Check>
      <Check>sla: latency p95 полевого прогона ниже 3000 ms</Check>
      <Check>quality: F1@1 выше baseline после C-003 и C-004 (сейчас synthetic proxy accuracy@1 = 0.175)</Check>
      <Check>privacy: git status без data/, .env, old/, my/, материалов конкурса</Check>
    </Gate>
  </Gates>
</GraceVerificationIndex>
